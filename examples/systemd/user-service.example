# First run: python3 scripts/install-native.py
# Prefer the generated open-room-renderer.service when using a custom prefix.
# Review and copy to ~/.config/systemd/user/open-room-renderer.service.
# No privileged port, root service, or global Python capability is needed.
[Unit]
Description=Open Room Renderer (unprivileged native profile)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/open-room-renderer
ExecStart=%h/.local/share/open-room-renderer/venv/bin/open-room-renderer serve --config %h/.local/share/open-room-renderer/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=yes
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
